{
  "expo": {
    "name": "EventPhotoSystem",
    "slug": "EventPhotoSystem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/eventphoto.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0616",
    "androidNavigationBar": {
      "backgroundColor": "#150B28",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.eventphotosystem.app",
      "backgroundColor": "#0B0616",
      "navigationBarColor": "#150B28",
      "icon": "./assets/eventphoto.png",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "eventphotosystem",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow EventPhotoSystem to access camera to take attendee photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow EventPhotoSystem to save attendee photos to your device gallery and DCIM/Camera folder.",
          "savePhotosPermission": "Allow EventPhotoSystem to save attendee photos to your device gallery and DCIM/Camera folder."
        }
      ],
      "./plugins/withAndroidLocalProperties"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b7e099a-b601-40fe-82b0-3c2e117a5b29"
      }
    }
  }
}
